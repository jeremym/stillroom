{
  "type": "object",
  "required": ["summary", "findings", "relevance"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "relevance": { "type": "string", "enum": ["high", "some", "none"] },
    "findings": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["claim", "quote"],
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string" },
          "quote": { "type": "string" }
        }
      }
    }
  }
}
